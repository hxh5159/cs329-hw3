# 复制为 .env，使用 UTF-8 保存。仅填入自己有权限使用的服务凭据。
TOGETHER_API_KEY=
MASSIVE_API_KEY=
WOLFRAM_APP_ID=
# 已开通 Google Custom Search 的用户可填写这两项。
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# 可选。下面的变量分别控制默认模型、固定评审模型和三个融合候选。
# CS329_MODEL=Qwen/Qwen3.5-9B
# CS329_JUDGE_MODEL=Qwen/Qwen3.5-9B
# CS329_CANDIDATE_MODELS=Qwen/Qwen3.5-9B,deepseek-ai/DeepSeek-V4.1-Flash-1017,MiniMaxAI/MiniMax-M3.1-Flash

# llmtoken 配置示例。启用时取消下面四行注释，按账户可用模型填写。
# CS329_BASE_URL=https://llmtoken.io/v1
# CS329_API_KEY=
# CS329_MODEL=deepseek-v4.1-flash
# CS329_CANDIDATE_MODELS=deepseek-v4.1-flash,qwen3.8,gpt-5.6-luna
